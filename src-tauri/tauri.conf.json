{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gh-feed",
  "version": "0.1.0",
  "identifier": "local.ghfeed.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitHub 信息流",
        "width": 1200,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "WebView2Loader.dll"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MDQ2RDhFNDhBNjhERDIKUldUU2phWklqbTBFNXRGbmxtajBwWjYvNVdZVzRGSThEOGVtYWxQWjFBeHFIbzB6Q0V6YnRFTm0K",
      "endpoints": [
        "https://your-host.example.com/web2exe/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}