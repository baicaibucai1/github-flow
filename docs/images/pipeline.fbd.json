        "titleH": 26,
        "titleAlign": "left",
        "dir": "row",
        "gap": 6,
        "pad": 6,
        "grow": 1,
        "children": [
          { "label": "repo\n曲线 days[7]", "tone": "teal", "size": 12, "grow": 1 },
          { "label": "feed_hit\n通道 · rrf · 命中词", "tone": "teal", "size": 12, "grow": 1 },
          { "label": "impression\n(项目,会话) 去重", "tone": "teal", "size": 12, "grow": 1 },
          { "label": "event\nstar/打开/停留/不感兴趣", "tone": "teal", "size": 11, "grow": 1.15 },
          { "label": "权重表\n分桶 n≥20 才生效", "tone": "teal", "size": 12, "grow": 1 },
          { "label": "缓存表\ndoc_cache · repo_file\nsocial_cache · translation", "tone": "teal", "size": 11, "grow": 1.25 }
        ]
      }
